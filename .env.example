# Copy to .env and fill in locally. Never commit .env.

# Location of the raw Gaussian-splat scene (outside Git).
VALMET_SCENE_PLY=data/raw/Equipment Room.ply
# Valmet synthetic equipment workbook (committed; the only tracked file under data/raw/).
VALMET_EQUIPMENT_XLSX=data/raw/equipment.xlsx
# Root folder for generated artifacts (one sub-folder per scene_id).
VALMET_PROCESSED_DIR=data/processed

# Optional: LLM for grounded diagnostics (diagnose_fault(use_llm=True)), any OpenAI-compatible
# endpoint. Leave the key empty to get the rule-based result (method "rule_based_fallback").
# Put the real key only in your local .env. NEVER commit an API key (not here, not in code).
FEATHERLESS_API_KEY=
# Endpoint; empty = https://api.featherless.ai/v1
VALMET_LLM_BASE_URL=
# Live model for diagnose_fault(use_llm=True); empty = Qwen/Qwen3.8-Flash-Next (60 s limit).
VALMET_LLM_MODEL=
# Model that builds the cached answers (python -m valmet.diagnostics.llm_diagnose --refresh);
# empty = moonshotai/Kimi-K3 (300 s limit, 32768 tokens). Cached answers are served to live
# calls whichever model made them, as long as rules, evidence and prompt are unchanged.
VALMET_LLM_CACHE_MODEL=
# Optional overrides. Defaults come from each model's profile in llm_client.MODEL_PROFILES
# and apply to whichever role is running:
# VALMET_LLM_TEMPERATURE=, VALMET_LLM_TOP_P=, VALMET_LLM_ENABLE_THINKING= (false | true | omit),
# VALMET_LLM_MAX_TOKENS= (thinking models count reasoning against it),
# VALMET_LLM_TIMEOUT_S= (hard wall-clock limit per call; default 60 live / 300 cache).
# Not used by the current LLM path.
ANTHROPIC_API_KEY=
